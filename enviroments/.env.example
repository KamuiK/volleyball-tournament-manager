# Neon PostgreSQL connection string.
# Do not commit a real connection string or credentials.
DATABASE_URL=

# Auth.js secret.
# Generate locally with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App credentials. See README.md for local callback setup.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated GitHub usernames authorized to use organizer features.
# Example format only; replace locally and never commit personal values.
ORGANIZER_GITHUB_LOGINS=organizer-example
